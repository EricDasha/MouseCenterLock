{
  "rules": [
    {
      "id": "left-hold-repeat-r-on-1-off-2",
      "name": "1로 감지 시작: 왼쪽 버튼을 누르는 동안 100ms마다 R, 2로 중지",
      "enabled": true,
      "triggerMode": "toggleLoop",
      "toggleOnKey": "1",
      "toggleOffKey": "2",
      "pressMouseButton": "left",
      "loopWhilePressHeld": true,
      "loopIntervalMs": 100,
      "actions": [
        {
          "type": "key",
          "key": "R"
        }
      ]
    }
  ]
}
