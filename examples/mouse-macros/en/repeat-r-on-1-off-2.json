{
  "rules": [
    {
      "id": "repeat-r-on-1-off-2",
      "name": "Press 1 to press R every 100ms, press 2 to stop",
      "enabled": true,
      "triggerMode": "toggleLoop",
      "toggleOnKey": "1",
      "toggleOffKey": "2",
      "loopIntervalMs": 100,
      "actions": [
        {
          "type": "key",
          "key": "R"
        }
      ]
    }
  ]
}
