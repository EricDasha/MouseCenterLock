{
  "rules": [
    {
      "id": "far-far-west-toggle-x1-auto-loop",
      "name": "Far Far West: press X1 to auto fire/switch, press again to stop",
      "enabled": true,
      "triggerMode": "toggleLoop",
      "holdMouseButton": "x1",
      "cancelOnFocusLost": true,
      "interruptible": true,
      "loopIntervalMs": 1,
      "actions": [
        {
          "type": "mouseDown",
          "button": "left"
        },
        {
          "type": "delay",
          "ms": 60
        },
        {
          "type": "mouseUp",
          "button": "left"
        },
        {
          "type": "delay",
          "ms": 120
        },
        {
          "type": "keyDown",
          "key": "2"
        },
        {
          "type": "delay",
          "ms": 80
        },
        {
          "type": "keyDown",
          "key": "1"
        },
        {
          "type": "delay",
          "ms": 27
        },
        {
          "type": "keyUp",
          "key": "2"
        },
        {
          "type": "delay",
          "ms": 66
        },
        {
          "type": "keyUp",
          "key": "1"
        }
      ],
      "onCancel": [
        {
          "type": "mouseUp",
          "button": "left"
        },
        {
          "type": "keyUp",
          "key": "2"
        },
        {
          "type": "keyUp",
          "key": "1"
        }
      ]
    }
  ]
}
