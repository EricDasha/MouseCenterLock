{
  "rules": [
    {
      "id": "repeat-r-on-1-off-2",
      "name": "按 1 开始每 100ms 按 R，按 2 停止",
      "enabled": true,
      "triggerMode": "toggleLoop",
      "toggleOnKey": "1",
      "toggleOffKey": "2",
      "loopIntervalMs": 100,
      "actions": [
        {
          "type": "key",
          "key": "R"
        }
      ]
    }
  ]
}
